{
  "manifest_version": 3,
  "name": "Jobs Analyzer Applicant Autofill",
  "version": "0.1.0",
  "description": "Fill Greenhouse applications with your locally stored profile.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://boards.eu.greenhouse.io/*",
    "https://job-boards.eu.greenhouse.io/*"
  ],
  "action": {
    "default_title": "Applicant Autofill",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
